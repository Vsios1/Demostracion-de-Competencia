<?xml version="1.0" encoding="UTF-8"?>
<toolchains xmlns="http://maven.apache.org/TOOLCHAINS/1.1.0" 
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://maven.apache.org/TOOLCHAINS/1.1.0 http://maven.apache.org/xsd/toolchains-1.1.0.xsd">
    
    <!-- Configuración para JDK 21 (LTS) -->
    <toolchain>
        <type>jdk</type>
        <provides>
            <version>21</version>
            <vendor>oracle</vendor>
        </provides>
        <configuration>
            <!-- ⚠️ IMPORTANTE: Ajusta esta ruta según tu instalación -->
            <jdkHome>C:\Program Files\Java\jdk-21</jdkHome>
        </configuration>
    </toolchain>

    <!-- Ejemplo de configuración alternativa para OpenJDK 21 -->
    <toolchain>
        <type>jdk</type>
        <provides>
            <version>21</version>
            <vendor>openjdk</vendor>
        </provides>
        <configuration>
            <!-- ⚠️ IMPORTANTE: Ajusta esta ruta según tu instalación -->
            <jdkHome>C:\Program Files\Eclipse Adoptium\jdk-21.0.1.12-hotspot</jdkHome>
        </configuration>
    </toolchain>
</toolchains>